# Build stage
# Pinned to the bookworm variant (not `rust:latest`) so the builder's glibc
# matches the debian:bookworm-slim runtime image below — a floating `latest`
# tag can silently move to a newer Debian release (e.g. trixie) and produce
# a binary the runtime's older glibc can't load.
FROM rust:bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y pkg-config libssl-dev cmake protobuf-compiler && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cache dependencies
COPY server-rust/Cargo.toml ./
COPY server-rust/Cargo.loc[k] ./
RUN mkdir src && echo 'fn main() {}' > src/main.rs && touch src/lib.rs && cargo build --release && rm src/main.rs src/lib.rs

# Build the actual application
COPY server-rust/build.rs ./
COPY server-rust/proto ./proto
COPY server-rust/src ./src
COPY server-rust/migrations ./migrations
RUN find src -name '*.rs' | xargs touch && cargo build --release

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/agenttrust-server /usr/local/bin/
COPY --from=builder /app/migrations /app/migrations

WORKDIR /app

EXPOSE 8000

CMD ["agenttrust-server"]
